generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  role             Role              @relation(fields: [roleId], references: [id])
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  commissionRules  CommissionRule[]  @relation("AgentCommissionRules")
  commissions      CommissionRecord[] @relation("AgentCommissions")
  notifications    Notification[]
  creditNotes      CreditNote[]
  salary           EmployeeSalary?
  employee         Employee?
  payrollLineItems PayrollLineItem[] @relation("EmployeePayroll")

  @@index([roleId])
}

model SystemFeature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  module      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]

  @@index([module])
  @@map("system_features")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  featureId String
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role    Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature SystemFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([roleId, featureId])
  @@index([roleId])
  @@index([featureId])
  @@map("role_permissions")
}

model ItAuditLog {
  id               String   @id @default(cuid())
  performedBy      String
  performedByEmail String
  action           String
  targetType       String
  targetId         String
  previousValue    Json?
  newValue         Json?
  ipAddress        String?
  createdAt        DateTime @default(now())

  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("it_audit_logs")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  projectId     String?
  status        InvoiceStatus @default(DRAFT)
  lineItems     Json
  subtotal      Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @db.Decimal(5, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  dueDate       DateTime
  sentAt        DateTime?
  paidAt        DateTime?
  writtenOffAt     DateTime?
  writtenOffBy     String?
  writeOffReason   String?
  writeOffCategory WriteOffCategory?
  creditTermsDays      Int           @default(30)
  notes                String?
  serviceType          String        @default("general")
  taxRateId            String?
  retainerContractId   String?
  createdBy            String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  payments         Payment[]
  reminders        InvoiceReminder[]
  creditNotes      CreditNote[]
  paymentPlan      PaymentPlan?
  appliedTaxRate   TaxRate?          @relation(fields: [taxRateId], references: [id])
  retainerContract RetainerContract? @relation("RetainerInvoices", fields: [retainerContractId], references: [id])
  creator          User              @relation(fields: [createdBy], references: [id])
  client           Client?           @relation("ClientInvoices", fields: [clientId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
  @@index([clientId])
  @@index([serviceType])
  @@index([paidAt])
  @@index([taxRateId])
  @@index([retainerContractId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum WriteOffCategory {
  CLIENT_DISPUTE
  CLIENT_INSOLVENT
  AGREED_WRITE_OFF
  UNCOLLECTABLE
  OTHER
}

model InvoiceReminder {
  id             String   @id @default(cuid())
  invoiceId      String
  reminderNumber Int
  sentAt         DateTime @default(now())
  emailAddress   String

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, reminderNumber])
  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  paidAt      DateTime
  receiptSent Boolean       @default(false)
  notes       String?
  recordedBy  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  recorder User    @relation(fields: [recordedBy], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
  CARD
}

model Expense {
  id         String          @id @default(cuid())
  vendorName String
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  currency   String          @default("USD")
  date       DateTime
  projectId          String?
  internalHourlyCost Decimal?        @db.Decimal(10, 2)
  receiptUrl         String?
  uploadPath         String?
  notes              String?
  createdBy          String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([date])
  @@index([projectId])
}

enum ExpenseCategory {
  STAFF
  SOFTWARE
  MARKETING
  OFFICE
  TRAVEL
  SUPPLIER
  OTHER
}

model Bill {
  id            String     @id @default(cuid())
  vendorName    String
  category      String
  amount        Decimal    @db.Decimal(12, 2)
  currency      String     @default("USD")
  dueDate       DateTime
  status        BillStatus @default(UNPAID)
  paidAt        DateTime?
  attachmentUrl String?
  notes         String?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@index([status])
  @@index([dueDate])
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model CommissionRule {
  id            String    @id @default(cuid())
  agentId       String
  serviceType   String?
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent User @relation("AgentCommissionRules", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([effectiveFrom])
  @@index([agentId, serviceType])
}

model CommissionRecord {
  id               String           @id @default(cuid())
  agentId          String
  dealId           String           @unique
  dealValue        Decimal          @db.Decimal(12, 2)
  serviceType      String
  ratePercent      Decimal          @db.Decimal(5, 2)
  calculatedAmount Decimal          @db.Decimal(12, 2)
  adjustedAmount   Decimal?         @db.Decimal(12, 2)
  adjustmentReason String?
  month            String
  status           CommissionStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  agent User @relation("AgentCommissions", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([month])
  @@index([status])
  @@index([month, status])
}

enum NotificationType {
  INVOICE_OVERDUE
  INVOICE_REMINDER_SENT
  INVOICE_PAID
  BILL_DUE_SOON
  BILL_OVERDUE
  PAYMENT_RECEIVED
  COMMISSION_APPROVED
  COMMISSION_REJECTED
  REMINDER_FAILED
  BUDGET_ALERT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model FinanceAuditLog {
  id            String   @id @default(cuid())
  userId        String
  userEmail     String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model CashFlowAdjustment {
  id        String    @id @default(cuid())
  label     String
  amount    Decimal   @db.Decimal(12, 2)
  direction String
  date      DateTime
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([date])
}

enum CreditNoteReason {
  OVERCHARGE
  SERVICE_NOT_DELIVERED
  DISCOUNT_AGREED
  REFUND_APPROVED
  OTHER
}

enum CreditNoteStatus {
  ISSUED
  REFUND_PENDING
  REFUND_PAID
  VOID
}

model CreditNote {
  id               String           @id @default(cuid())
  creditNoteNumber String           @unique
  invoiceId        String
  amount           Decimal          @db.Decimal(12, 2)
  reason           CreditNoteReason
  description      String
  status           CreditNoteStatus @default(ISSUED)
  issuedAt         DateTime         @default(now())
  refundDue        Boolean          @default(false)
  refundPaidAt     DateTime?
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@index([createdAt])
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstalmentStatus {
  PENDING
  PAID
  OVERDUE
}

model PaymentPlan {
  id          String            @id @default(cuid())
  invoiceId   String            @unique
  totalAmount Decimal           @db.Decimal(12, 2)
  status      PaymentPlanStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  invoice     Invoice           @relation(fields: [invoiceId], references: [id])
  instalments PaymentPlanItem[]
}

model PaymentPlanItem {
  id               String           @id @default(cuid())
  paymentPlanId    String
  instalmentNumber Int
  amount           Decimal          @db.Decimal(12, 2)
  dueDate          DateTime
  status           InstalmentStatus @default(PENDING)
  paidAt           DateTime?
  paymentId        String?

  plan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId])
  @@index([dueDate])
  @@index([status])
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
  DISCREPANCY
}

enum TransactionMatchStatus {
  MATCHED
  UNMATCHED
  MANUALLY_RESOLVED
  IGNORED
}

model BankStatement {
  id               String               @id @default(cuid())
  periodFrom       DateTime
  periodTo         DateTime
  importedAt       DateTime             @default(now())
  importedBy       String
  status           ReconciliationStatus @default(IN_PROGRESS)
  completedAt      DateTime?
  openingBalance   Decimal              @db.Decimal(12, 2)
  closingBalance   Decimal              @db.Decimal(12, 2)
  transactionCount Int
  matchedCount     Int                  @default(0)
  unmatchedCount   Int                  @default(0)

  transactions BankTransaction[]

  @@index([periodFrom])
}

model BankTransaction {
  id                String                 @id @default(cuid())
  bankStatementId   String
  transactionDate   DateTime
  description       String
  debitAmount       Decimal?               @db.Decimal(12, 2)
  creditAmount      Decimal?               @db.Decimal(12, 2)
  balance           Decimal                @db.Decimal(12, 2)
  reference         String?
  matchStatus       TransactionMatchStatus @default(UNMATCHED)
  matchedEntityType String?
  matchedEntityId   String?
  resolvedBy        String?
  resolvedAt        DateTime?
  resolvedNote      String?

  statement BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  @@index([bankStatementId])
  @@index([matchStatus])
  @@index([transactionDate])
}

model TaxRate {
  id            String    @id @default(cuid())
  name          String
  ratePercent   Decimal   @db.Decimal(5, 2)
  country       String
  serviceType   String?
  effectiveFrom DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoices  Invoice[]
  retainers RetainerContract[]

  @@index([country])
  @@index([serviceType])
  @@index([isActive])
}

model TaxPayment {
  id            String   @id @default(cuid())
  authorityName String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("RWF")
  paidAt        DateTime
  reference     String?
  periodFrom    DateTime
  periodTo      DateTime
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([paidAt])
  @@index([periodFrom])
}

enum RetainerStatus {
  ACTIVE
  PAUSED
  ENDED
}

model RetainerContract {
  id                String         @id @default(cuid())
  clientId          String
  serviceName       String
  description       String?
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("USD")
  billingDayOfMonth Int
  startDate         DateTime
  endDate           DateTime?
  status            RetainerStatus @default(ACTIVE)
  taxRateId         String?
  nextBillingDate   DateTime
  lastBilledAt      DateTime?
  pausedAt          DateTime?
  pauseReason       String?
  endedAt           DateTime?
  endReason         String?
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  taxRate  TaxRate?  @relation(fields: [taxRateId], references: [id])
  invoices Invoice[] @relation("RetainerInvoices")

  @@index([status])
  @@index([nextBillingDate])
  @@index([clientId])
}

enum BudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectBudget {
  id                String    @id @default(cuid())
  projectId         String    @unique
  projectName       String
  clientId          String
  approvedBudget    Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD")
  alertThresholdPct Int       @default(80)
  alertSentAt       DateTime?
  isBlocked         Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  increaseRequests BudgetIncreaseRequest[]

  @@index([projectId])
  @@index([clientId])
}

model BudgetIncreaseRequest {
  id              String              @id @default(cuid())
  projectId       String
  currentBudget   Decimal             @db.Decimal(12, 2)
  requestedBudget Decimal             @db.Decimal(12, 2)
  justification   String
  requestedBy     String
  status          BudgetRequestStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  budget ProjectBudget @relation(fields: [projectId], references: [projectId])

  @@index([projectId])
  @@index([status])
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  LOCKED
}

model PayrollRun {
  id              String        @id @default(cuid())
  month           String
  status          PayrollStatus @default(DRAFT)
  processedAt     DateTime?
  processedBy     String?
  lockedAt        DateTime?
  lockedBy        String?
  totalGross      Decimal       @db.Decimal(12, 2) @default(0)
  totalDeductions Decimal       @db.Decimal(12, 2) @default(0)
  totalNet        Decimal       @db.Decimal(12, 2) @default(0)
  currency        String        @default("USD")
  notes           String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems PayrollLineItem[]

  @@unique([month])
  @@index([status])
  @@index([month])
}

model PayrollLineItem {
  id               String   @id @default(cuid())
  payrollRunId     String
  employeeId       String
  employeeName     String
  employeeEmail    String
  baseSalary       Decimal  @db.Decimal(12, 2)
  commission       Decimal  @db.Decimal(12, 2) @default(0)
  bonus            Decimal  @db.Decimal(12, 2) @default(0)
  grossPay         Decimal  @db.Decimal(12, 2)
  taxDeduction     Decimal  @db.Decimal(12, 2) @default(0)
  otherDeductions  Decimal  @db.Decimal(12, 2) @default(0)
  netPay           Decimal  @db.Decimal(12, 2)
  payslipSent      Boolean  @default(false)
  payslipUrl       String?
  notes            String?
  adjustedBy       String?
  adjustmentReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   User?      @relation("EmployeePayroll", fields: [employeeId], references: [id])

  @@index([payrollRunId])
  @@index([employeeId])
}

model EmployeeSalary {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employeeName  String
  employeeEmail String
  baseSalary    Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee User @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([isActive])
}

enum BalanceSheetType {
  ASSET
  LIABILITY
}

model BalanceSheetEntry {
  id        String           @id @default(cuid())
  type      BalanceSheetType
  label     String
  amount    Decimal          @db.Decimal(12, 2)
  currency  String           @default("USD")
  asOfDate  DateTime         @default(now())
  notes     String?
  createdBy String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([asOfDate])
}

model FinanceSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model Client {
  id          String    @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  country     String    @default("RW")
  city        String?
  address     String?
  website     String?
  industry    String?
  notes       String?
  assignedTo  String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  leads    Lead[]
  invoices Invoice[] @relation("ClientInvoices")

  @@index([assignedTo])
  @@index([createdAt])
}

model Lead {
  id              String        @id @default(cuid())
  contactName     String
  companyName     String
  email           String
  phone           String?
  country         String        @default("RW")
  serviceInterest String
  source          LeadSource
  estimatedValue  Decimal?      @db.Decimal(12, 2)
  currency        String        @default("USD")
  stage           PipelineStage @default(NEW)
  qualityScore    Int?          @default(0)
  assignedTo      String?
  clientId        String?
  notes           String?
  lostReason      String?
  convertedAt     DateTime?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  activities LeadActivity[]
  proposals  Proposal[]
  client     Client?        @relation(fields: [clientId], references: [id])

  @@index([stage])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([source])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_OUTREACH
  EVENT
  PARTNER
  RETURNING_CLIENT
  OTHER
}

enum PipelineStage {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model LeadActivity {
  id             String       @id @default(cuid())
  leadId         String
  type           ActivityType
  summary        String
  outcome        String?
  nextAction     String?
  nextActionDate DateTime?
  duration       Int?
  performedBy    String
  performedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([performedAt])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  NOTE
}

model Proposal {
  id              String         @id @default(cuid())
  leadId          String
  title           String
  serviceType     String
  estimatedValue  Decimal        @db.Decimal(12, 2)
  currency        String         @default("USD")
  status          ProposalStatus @default(DRAFT)
  sentAt          DateTime?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model PipelineStageHistory {
  id         String         @id @default(cuid())
  leadId     String
  fromStage  PipelineStage?
  toStage    PipelineStage
  movedBy    String
  movedAt    DateTime       @default(now())
  daysInPrev Int?

  @@index([leadId])
  @@index([movedAt])
}

model SalesTarget {
  id            String   @id @default(cuid())
  agentId       String
  month         String
  revenueTarget Decimal  @db.Decimal(12, 2)
  dealsTarget   Int
  currency      String   @default("USD")
  setBy         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, month])
  @@index([agentId])
  @@index([month])
}

model CrmNotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  followUpReminders    Boolean  @default(true)
  proposalExpiryAlerts Boolean  @default(true)
  dealClosedAlerts     Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model CrmSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model CrmAuditLog {
  id            String   @id @default(cuid())
  userId        String
  userEmail     String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  module    String
  createdAt DateTime @default(now())

  @@index([userId, module])
}

// ─── HR Module ─────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id                    String         @id @default(cuid())
  userId                String         @unique
  employeeCode          String         @unique
  firstName             String
  lastName              String
  email                 String         @unique
  phone                 String?
  profilePhotoUrl       String?
  jobTitle              String
  departmentId          String?
  managerId             String?
  employmentType        EmploymentType @default(FULL_TIME)
  status                EmployeeStatus @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime?
  baseSalary            Decimal        @db.Decimal(12, 2)
  currency              String         @default("USD")
  salaryEffectiveFrom   DateTime       @default(now())
  nationalId            String?
  bankName              String?
  bankAccount           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdBy             String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  user          User               @relation(fields: [userId], references: [id])
  department    Department?        @relation(fields: [departmentId], references: [id])
  manager       Employee?          @relation("ManagerEmployee", fields: [managerId], references: [id])
  managedEmployees Employee[]      @relation("ManagerEmployee")
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  attendance         AttendanceRecord[]
  performanceReviews PerformanceReview[]
  salaryHistory      SalaryHistory[]
  onboarding         OnboardingChecklist?

  @@index([departmentId])
  @@index([status])
  @@index([managerId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

model LeaveType {
  id               String   @id @default(cuid())
  name             String   @unique
  code             String   @unique
  defaultDaysPerYear Int      @default(0)
  isPaid           Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  requiresDocument Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  entitled    Decimal  @db.Decimal(6, 2)
  used        Decimal  @db.Decimal(6, 2) @default(0)
  pending     Decimal  @db.Decimal(6, 2) @default(0)
  remaining   Decimal  @db.Decimal(6, 2)
  carryOver   Decimal  @db.Decimal(6, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([year])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal     @db.Decimal(6, 2)
  reason          String?
  documentUrl     String?
  status          LeaveStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  employeeId   String
  date         DateTime
  checkInAt    DateTime?
  checkOutAt   DateTime?
  status       AttendanceStatus @default(PRESENT)
  workingHours Decimal?         @db.Decimal(5, 2)
  notes        String?
  recordedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  PUBLIC_HOLIDAY
  WEEKEND
}

model HrSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

// ─── Performance Review (Sprint 14) ─────────────────────────────

model PerformanceReview {
  id              String       @id @default(cuid())
  employeeId      String
  reviewerId      String
  period          String
  reviewDate      DateTime
  status          ReviewStatus @default(DRAFT)

  goalsSet        Json?
  selfAssessment  String?
  selfRating      Int?
  managerNotes    String?
  overallRating   Int?
  strengths       String?
  improvements    String?
  nextPeriodGoals Json?
  acknowledgedAt  DateTime?
  nextReviewDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([period])
  @@index([status])
  @@index([reviewerId])
}

enum ReviewStatus {
  DRAFT
  SELF_ASSESSMENT
  MANAGER_REVIEW
  ACKNOWLEDGED
  COMPLETED
}

// ─── Salary History (Sprint 14) ─────────────────────────────────

model SalaryHistory {
  id             String   @id @default(cuid())
  employeeId     String
  previousSalary Decimal  @db.Decimal(12, 2)
  newSalary      Decimal  @db.Decimal(12, 2)
  currency       String
  effectiveFrom  DateTime
  reason         String?
  changedBy      String
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveFrom])
}

// ─── Onboarding Checklist (Sprint 14) ───────────────────────────

model OnboardingChecklist {
  id          String           @id @default(cuid())
  employeeId  String           @unique
  status      OnboardingStatus @default(IN_PROGRESS)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id])
  items    OnboardingItem[]
}

model OnboardingItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  description String?
  category    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  dueDate     DateTime?
  order       Int

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ─── HR Audit Log (Sprint 14) ───────────────────────────────────

model HrAuditLog {
  id            String   @id @default(cuid())
  userId        String
  userEmail     String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
