  POST
  REEL
  STORY
  CAROUSEL
  VIDEO
  BLOG
  EMAIL
  AD
}

enum ContentStatus {
  DRAFT
  READY
  APPROVED
  PUBLISHED
  REJECTED
  CANCELLED
}

// ─── Sprint 19: Software & Web Dev Services ───────────────────

model SoftwareProject {
  id                String              @id @default(cuid())
  clientId          String
  projectId         String?
  name              String
  description       String?
  projectType       SoftwareProjectType @default(WEBSITE)
  phase             SoftwarePhase       @default(REQUIREMENTS)
  startDate         DateTime
  deployedAt        DateTime?
  maintenanceEndsAt DateTime?
  isActive          Boolean             @default(true)
  totalCost         Decimal?            @db.Decimal(12, 2)
  currency          String              @default("RWF")
  invoiceId         String?
  notes             String?
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  client          Client           @relation(fields: [clientId], references: [id])
  requirements    RequirementDoc[]
  designPhase     DesignPhase?
  devSprints      DevSprint[]
  qaPhase         QaPhase?
  deployment      Deployment?
  maintenanceLogs MaintenanceLog[]

  @@index([clientId])
  @@index([phase])
  @@index([isActive])
  @@index([clientId, isActive])
  @@index([deletedAt])
}

enum SoftwareProjectType {
  WEBSITE
  WEB_APP
  MOBILE_APP
  SYSTEM
  OTHER
}

enum SoftwarePhase {
  REQUIREMENTS
  DESIGN
  DEVELOPMENT
  QA
  DEPLOYMENT
  MAINTENANCE
  COMPLETED
}

model RequirementDoc {
  id                String    @id @default(cuid())
  softwareProjectId String
  title             String
  content           String
  version           Int       @default(1)
  fileUrl           String?
  status            DocStatus @default(DRAFT)
  sentToClientAt    DateTime?
  clientSignedAt    DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  softwareProject SoftwareProject @relation(fields: [softwareProjectId], references: [id])

  @@index([softwareProjectId])
  @@index([deletedAt])
}

enum DocStatus {
  DRAFT
  SENT
  SIGNED
  REVISED
}

model DesignPhase {
  id                String       @id @default(cuid())
  softwareProjectId String       @unique
  figmaUrl          String?
  isSkipped         Boolean      @default(false)
  status            DesignStatus @default(IN_PROGRESS)
  sentToClientAt    DateTime?
  clientApprovedAt  DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  softwareProject SoftwareProject @relation(fields: [softwareProjectId], references: [id])
}

enum DesignStatus {
  IN_PROGRESS
  SENT
  APPROVED
  CHANGES_REQUESTED
  SKIPPED
}

model DevSprint {
  id                String       @id @default(cuid())
  softwareProjectId String
  name              String
  goal              String?
  startDate         DateTime
  endDate           DateTime
  status            SprintStatus @default(PLANNED)
  completedAt       DateTime?
  milestoneId       String?
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  softwareProject SoftwareProject @relation(fields: [softwareProjectId], references: [id])
  items           SprintItem[]

  @@index([softwareProjectId])
  @@index([status])
  @@index([deletedAt])
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  SKIPPED
}

model SprintItem {
  id          String     @id @default(cuid())
  sprintId    String
  title       String
  description String?
  status      ItemStatus @default(TODO)
  assigneeId  String?
  storyPoints Int?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  sprint DevSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([status])
  @@index([deletedAt])
}

enum ItemStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model QaPhase {
  id                String    @id @default(cuid())
  softwareProjectId String    @unique
  isSkipped         Boolean   @default(false)
  status            QaStatus  @default(IN_PROGRESS)
  startedAt         DateTime?
  completedAt       DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  softwareProject SoftwareProject @relation(fields: [softwareProjectId], references: [id])
  bugs            Bug[]
}

enum QaStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model Bug {
  id          String      @id @default(cuid())
  qaPhaseId   String
  title       String
  description String?
  severity    BugSeverity @default(MEDIUM)
  status      BugStatus   @default(OPEN)
  assigneeId  String?
  resolvedAt  DateTime?
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  qaPhase QaPhase @relation(fields: [qaPhaseId], references: [id], onDelete: Cascade)

  @@index([qaPhaseId])
  @@index([status])
  @@index([severity])
  @@index([deletedAt])
}

enum BugSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

model Deployment {
  id                String   @id @default(cuid())
  softwareProjectId String   @unique
  deployedAt        DateTime
  deploymentUrl     String?
  serverDetails     String?
  deployedBy        String
  notes             String?
  createdAt         DateTime @default(now())

  softwareProject SoftwareProject @relation(fields: [softwareProjectId], references: [id])
}

model MaintenanceLog {
  id                String            @id @default(cuid())
  softwareProjectId String
  title             String
  description       String
  type              MaintenanceType
  status            MaintenanceStatus @default(OPEN)
  priority          BugSeverity       @default(MEDIUM)
  reportedAt        DateTime          @default(now())
  resolvedAt        DateTime?
  assigneeId        String?
  notes             String?
  createdBy         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  softwareProject SoftwareProject @relation(fields: [softwareProjectId], references: [id])

  @@index([softwareProjectId])
  @@index([status])
  @@index([deletedAt])
}

enum MaintenanceType {
  BUG
  UPDATE
  SECURITY
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ─── Branding Project ─────────────────────────────────────────
model BrandingProject {
  id          String         @id @default(cuid())
  clientId    String
  projectId   String?
  name        String
  description String?
  status      BrandingStatus @default(IN_PROGRESS)
  deliveredAt DateTime?
  totalCost   Decimal?       @db.Decimal(12, 2)
  currency    String         @default("RWF")
  invoiceId   String?
  notes       String?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  client     Client              @relation(fields: [clientId], references: [id])
  scopeItems BrandingScopeItem[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

enum BrandingStatus {
  IN_PROGRESS
  DELIVERED
  ON_HOLD
  CANCELLED
}

// ─── Branding Scope Item ──────────────────────────────────────
model BrandingScopeItem {
  id                String      @id @default(cuid())
  brandingProjectId String
  title             String
  description       String?
  supplierId        String?
  status            ScopeStatus @default(IN_PROGRESS)
  deliveredAt       DateTime?
  notes             String?
  order             Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  brandingProject BrandingProject    @relation(fields: [brandingProjectId], references: [id], onDelete: Cascade)
  supplier        BrandingSupplier?  @relation(fields: [supplierId], references: [id])
  submissions     DesignSubmission[]

  @@index([brandingProjectId])
  @@index([status])
  @@index([brandingProjectId, status])
  @@index([deletedAt])
}

enum ScopeStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  DELIVERED
}

// ─── Design Submission ────────────────────────────────────────
model DesignSubmission {
  id             String           @id @default(cuid())
  deletedAt      DateTime?
  scopeItemId    String
  version        Int
  fileUrl        String?
  description    String?
  status         SubmissionStatus @default(PENDING)
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  clientFeedback String?
  submittedBy    String
  reviewedBy     String?

  scopeItem BrandingScopeItem @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)

  @@index([scopeItemId])
  @@index([deletedAt])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Branding Supplier ────────────────────────────────────────
model BrandingSupplier {
  id          String    @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  isActive    Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  scopeItems BrandingScopeItem[]

  @@index([deletedAt])
}

// ─── Sprint 21: Influencer Marketing ─────────────────────────

model Influencer {
  id             String    @id @default(cuid())
  name           String
  handle         String
  platform       String
  otherPlatforms String[]
  followersCount Int?
  email          String?
  phone          String?
  location       String?
  category       String?
  notes          String?
  isActive       Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  assignments CampaignInfluencer[]

  @@index([platform])
  @@index([isActive])
  @@index([deletedAt])
}

model InfluencerCampaign {
  id          String         @id @default(cuid())
  clientId    String
  projectId   String?
  name        String
  brief       String?
  platforms   String[]
  budget      Decimal?       @db.Decimal(12, 2)
  currency    String         @default("RWF")
  totalCost   Decimal?       @db.Decimal(12, 2)
  invoiceId   String?
  startDate   DateTime
  endDate     DateTime?
  status      CampaignStatus @default(ACTIVE)
  completedAt DateTime?
  notes       String?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  client      Client               @relation(fields: [clientId], references: [id])
  influencers CampaignInfluencer[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

model CampaignInfluencer {
  id           String    @id @default(cuid())
  deletedAt    DateTime?
  campaignId   String
  influencerId String
  agreedFee    Decimal?  @db.Decimal(10, 2)
  currency     String    @default("RWF")
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  paidAmount   Decimal?  @db.Decimal(10, 2)
  paymentNotes String?
  expenseId    String?
  notes        String?
  addedAt      DateTime  @default(now())

  campaign     InfluencerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer   Influencer         @relation(fields: [influencerId], references: [id])
  deliverables Deliverable[]

  @@unique([campaignId, influencerId])
  @@index([campaignId])
  @@index([influencerId])
  @@index([deletedAt])
}

model Deliverable {
  id                   String            @id @default(cuid())
  campaignInfluencerId String
  description          String
  platform             String
  contentType          String
  dueDate              DateTime?
  status               DeliverableStatus @default(PENDING)
  verifiedAt           DateTime?
  verifiedBy           String?
  postUrl              String?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  campaignInfluencer CampaignInfluencer @relation(fields: [campaignInfluencerId], references: [id], onDelete: Cascade)

  @@index([campaignInfluencerId])
  @@index([status])
  @@index([campaignInfluencerId, status])
  @@index([deletedAt])
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  VERIFIED
  MISSED
}

// ─── Sprint 22: Sales Services ────────────────────────────────

model SalesCampaign {
  id             String              @id @default(cuid())
  clientId       String
  projectId      String?
  name           String
  productService String
  territory      String?
  startDate      DateTime
  endDate        DateTime?
  status         SalesCampaignStatus @default(ACTIVE)
  completedAt    DateTime?
  visitTarget    Int?
  leadTarget     Int?
  salesTarget    Int?
  totalCost      Decimal?            @db.Decimal(12, 2)
  currency       String              @default("RWF")
  invoiceId      String?
  notes          String?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  client        Client             @relation(fields: [clientId], references: [id])
  agents        SalesAgent[]
  dailyLogs     DailyActivityLog[]
  weeklyReports WeeklyReport[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

enum SalesCampaignStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

model SalesAgent {
  id          String    @id @default(cuid())
  deletedAt   DateTime?
  campaignId  String
  employeeId  String
  territory   String?
  visitTarget Int?
  leadTarget  Int?
  salesTarget Int?
  joinedAt    DateTime  @default(now())
  isActive    Boolean   @default(true)

  campaign  SalesCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dailyLogs DailyActivityLog[]

  @@unique([campaignId, employeeId])
  @@index([campaignId])
  @@index([employeeId])
  @@index([deletedAt])
}

model DailyActivityLog {
  id          String    @id @default(cuid())
  campaignId  String
  agentId     String
  employeeId  String
  date        DateTime
  visitsCount Int       @default(0)
  leadsCount  Int       @default(0)
  salesCount  Int       @default(0)
  salesAmount Decimal?  @db.Decimal(12, 2)
  notes       String?
  challenges  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  campaign SalesCampaign @relation(fields: [campaignId], references: [id])
  agent    SalesAgent    @relation(fields: [agentId], references: [id])

  @@unique([agentId, date])
  @@index([campaignId])
  @@index([agentId])
  @@index([date])
  @@index([campaignId, date])
  @@index([deletedAt])
}

model WeeklyReport {
  id               String    @id @default(cuid())
  deletedAt        DateTime?
  campaignId       String
  weekStart        DateTime
  weekEnd          DateTime
  weekNumber       Int
  totalVisits      Int
  totalLeads       Int
  totalSales       Int
  totalSalesAmount Decimal?  @db.Decimal(12, 2)
  activeAgents     Int
  highlights       String?
  challenges       String?
  nextWeekPlan     String?
  generatedAt      DateTime  @default(now())
  generatedBy      String

  campaign SalesCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, weekNumber])
  @@index([campaignId])
  @@index([deletedAt])
}

// ─── Sprint 25: Monitoring ─────────────────────────────────────

model CronLog {
  id             String   @id @default(cuid())
  jobName        String
  startedAt      DateTime
  completedAt    DateTime
  itemsProcessed Int      @default(0)
  errors         Int      @default(0)
  status         String   @default("SUCCESS")
  createdAt      DateTime @default(now())

  @@index([jobName])
  @@index([startedAt])
  @@index([jobName, startedAt])
}

// ─── Reserve Fund ──────────────────────────────────────────────

model ReserveAccount {
  id        String   @id @default(cuid())
  name      String   @default("CDY Company Reserve")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("RWF")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions ReserveTransaction[]
}

model ReserveTransaction {
  id               String      @id @default(cuid())
  reserveAccountId String
  type             ReserveType
  amount           Decimal     @db.Decimal(12, 2)
  balanceAfter     Decimal     @db.Decimal(12, 2)
  description      String
  reference        String?
  createdBy        String
  createdAt        DateTime    @default(now())

  reserveAccount ReserveAccount @relation(fields: [reserveAccountId], references: [id])

  @@index([reserveAccountId])
  @@index([createdAt])
  @@index([type])
}

enum ReserveType {
  DEPOSIT
  WITHDRAWAL
}
