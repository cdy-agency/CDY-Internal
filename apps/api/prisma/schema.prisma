generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  role             Role               @relation(fields: [roleId], references: [id])
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  commissionRules  CommissionRule[]   @relation("AgentCommissionRules")
  commissions      CommissionRecord[] @relation("AgentCommissions")
  notifications    Notification[]
  creditNotes      CreditNote[]
  salary           EmployeeSalary?
  employee         Employee?
  payrollLineItems PayrollLineItem[]  @relation("EmployeePayroll")
  directIncomes    DirectIncome[]

  @@index([roleId])
  @@index([deletedAt])
}

model SystemFeature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  module      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]

  @@index([module])
  @@map("system_features")
}

model Role {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  homeModule  String    @default("/finance")
  description String?
  isDefault   Boolean   @default(false)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       User[]

  @@index([deletedAt])
  @@map("roles")
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  featureId String
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role    Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature SystemFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([roleId, featureId])
  @@index([roleId])
  @@index([featureId])
  @@map("role_permissions")
}

model ItAuditLog {
  id               String   @id @default(cuid())
  performedBy      String
  performedByEmail String
  action           String
  targetType       String
  targetId         String
  previousValue    Json?
  newValue         Json?
  ipAddress        String?
  createdAt        DateTime @default(now())

  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("it_audit_logs")
}

/// Atomic counters for document numbers (invoices, credit notes).
/// `generate()` increments under an advisory lock so concurrent creates
/// never share the same number — the previous "read max then insert later"
/// pattern released the lock before the invoice row existed (P2002 races).
model NumberSequence {
  id        String   @id // e.g. "invoice:2026", "credit-note:2026"
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                 String            @id @default(cuid())
  invoiceNumber      String            @unique
  clientId           String
  projectId          String?
  status             InvoiceStatus     @default(DRAFT)
  lineItems          Json
  subtotal           Decimal           @db.Decimal(12, 2)
  taxRate            Decimal           @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal           @default(0) @db.Decimal(12, 2)
  total              Decimal           @db.Decimal(12, 2)
  currency           String            @default("USD")
  dueDate            DateTime
  sentAt             DateTime?
  paidAt             DateTime?
  writtenOffAt       DateTime?
  writtenOffBy       String?
  writeOffReason     String?
  writeOffCategory   WriteOffCategory?
  creditTermsDays    Int               @default(30)
  notes              String?
  serviceType        String            @default("general")
  taxRateId          String?
  retainerContractId String?
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  ventureId String?

  payments         Payment[]
  reminders        InvoiceReminder[]
  creditNotes      CreditNote[]
  paymentPlan      PaymentPlan?
  appliedTaxRate   TaxRate?          @relation(fields: [taxRateId], references: [id])
  retainerContract RetainerContract? @relation("RetainerInvoices", fields: [retainerContractId], references: [id])
  creator          User              @relation(fields: [createdBy], references: [id])
  client           Client?           @relation("ClientInvoices", fields: [clientId], references: [id])
  venture          Venture?          @relation(fields: [ventureId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
  @@index([clientId])
  @@index([serviceType])
  @@index([paidAt])
  @@index([taxRateId])
  @@index([retainerContractId])
  @@index([ventureId])
  @@index([deletedAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum WriteOffCategory {
  CLIENT_DISPUTE
  CLIENT_INSOLVENT
  AGREED_WRITE_OFF
  UNCOLLECTABLE
  OTHER
}

model InvoiceReminder {
  id             String   @id @default(cuid())
  invoiceId      String
  reminderNumber Int
  sentAt         DateTime @default(now())
  emailAddress   String

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, reminderNumber])
  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  accountId   String?
  paidAt      DateTime
  receiptSent Boolean       @default(false)
  notes       String?
  recordedBy  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  invoice  Invoice         @relation(fields: [invoiceId], references: [id])
  recorder User            @relation(fields: [recordedBy], references: [id])
  account  CompanyAccount? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@index([accountId])
  @@index([deletedAt])
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  MTN_MOMO
  AIRTEL_MONEY
  CASH
  CARD
  OTHER
}

// A company-owned receiving account (bank or mobile money line) that an
// invoice payment can optionally be attributed to, so Finance can tell
// which of the company's own accounts the money actually landed in.
model CompanyAccount {
  id            String             @id @default(cuid())
  name          String
  type          CompanyAccountType
  provider      String?
  accountNumber String?
  currency      String?
  isActive      Boolean            @default(true)
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  payments Payment[]

  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
}

enum CompanyAccountType {
  BANK
  MOBILE_MONEY
  OTHER
}

model Expense {
  id                  String          @id @default(cuid())
  vendorName          String
  category            ExpenseCategory
  amount              Decimal         @db.Decimal(12, 2)
  currency            String          @default("RWF")
  date                DateTime
  projectId           String?
  ventureId           String?
  ventureSharePercent Decimal?        @db.Decimal(5, 2)
  internalHourlyCost  Decimal?        @db.Decimal(10, 2)
  receiptUrl          String?
  uploadPath          String?
  notes               String?
  isPayrollExpense    Boolean         @default(false)
  payrollRunId        String?
  paymentMethod       PaymentMethod?
  paymentReference    String?
  createdBy           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  creator    User        @relation(fields: [createdBy], references: [id])
  venture    Venture?    @relation(fields: [ventureId], references: [id])
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id])

  @@index([category])
  @@index([date])
  @@index([projectId])
  @@index([ventureId])
  @@index([payrollRunId])
  @@index([deletedAt])
}

enum ExpenseCategory {
  STAFF
  SOFTWARE
  MARKETING
  OFFICE
  TRAVEL
  SUPPLIER
  COMMISSION
  INFLUENCER_PAYMENT
  LOAN
  OTHER
}

model Bill {
  id            String     @id @default(cuid())
  vendorName    String
  category      String
  amount        Decimal    @db.Decimal(12, 2)
  currency      String     @default("USD")
  dueDate       DateTime
  status        BillStatus @default(UNPAID)
  paidAt        DateTime?
  attachmentUrl String?
  notes         String?
  instalmentId  String?    @unique
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  instalment PaymentPlanItem? @relation(fields: [instalmentId], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([instalmentId])
  @@index([deletedAt])
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model CommissionRule {
  id            String    @id @default(cuid())
  agentId       String
  serviceType   String?
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  agent User @relation("AgentCommissionRules", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([effectiveFrom])
  @@index([agentId, serviceType])
  @@index([deletedAt])
}

model CommissionRecord {
  id               String           @id @default(cuid())
  agentId          String
  dealId           String           @unique
  dealValue        Decimal          @db.Decimal(12, 2)
  serviceType      String
  ratePercent      Decimal          @db.Decimal(5, 2)
  calculatedAmount Decimal          @db.Decimal(12, 2)
  adjustedAmount   Decimal?         @db.Decimal(12, 2)
  adjustmentReason String?
  month            String
  status           CommissionStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  agent User @relation("AgentCommissions", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([month])
  @@index([status])
  @@index([month, status])
  @@index([deletedAt])
}

enum NotificationType {
  INVOICE_OVERDUE
  INVOICE_REMINDER_SENT
  INVOICE_PAID
  BILL_DUE_SOON
  BILL_OVERDUE
  PAYMENT_RECEIVED
  COMMISSION_APPROVED
  COMMISSION_REJECTED
  REMINDER_FAILED
  BUDGET_ALERT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@index([deletedAt])
}

model FinanceAuditLog {
  id            String   @id @default(cuid())
  userId        String
  userEmail     String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model CashFlowAdjustment {
  id        String    @id @default(cuid())
  label     String
  amount    Decimal   @db.Decimal(12, 2)
  direction String
  date      DateTime
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([date])
  @@index([deletedAt])
}

enum CreditNoteReason {
  OVERCHARGE
  SERVICE_NOT_DELIVERED
  DISCOUNT_AGREED
  REFUND_APPROVED
  OTHER
}

enum CreditNoteStatus {
  ISSUED
  REFUND_PENDING
  REFUND_PAID
  VOID
}

model CreditNote {
  id               String           @id @default(cuid())
  creditNoteNumber String           @unique
  invoiceId        String
  amount           Decimal          @db.Decimal(12, 2)
  reason           CreditNoteReason
  description      String
  status           CreditNoteStatus @default(ISSUED)
  issuedAt         DateTime         @default(now())
  refundDue        Boolean          @default(false)
  refundPaidAt     DateTime?
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@index([createdAt])
  @@index([deletedAt])
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstalmentStatus {
  PENDING
  PAID
  OVERDUE
}

model PaymentPlan {
  id          String            @id @default(cuid())
  invoiceId   String            @unique
  totalAmount Decimal           @db.Decimal(12, 2)
  status      PaymentPlanStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  invoice     Invoice           @relation(fields: [invoiceId], references: [id])
  instalments PaymentPlanItem[]

  @@index([deletedAt])
}

model PaymentPlanItem {
  id               String           @id @default(cuid())
  deletedAt        DateTime?
  paymentPlanId    String
  instalmentNumber Int
  amount           Decimal          @db.Decimal(12, 2)
  dueDate          DateTime
  status           InstalmentStatus @default(PENDING)
  paidAt           DateTime?
  paymentId        String?

  plan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  bill Bill?

  @@index([paymentPlanId])
  @@index([dueDate])
  @@index([status])
  @@index([deletedAt])
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
  DISCREPANCY
}

enum TransactionMatchStatus {
  MATCHED
  UNMATCHED
  MANUALLY_RESOLVED
  IGNORED
}

model BankStatement {
  id               String               @id @default(cuid())
  deletedAt        DateTime?
  periodFrom       DateTime
  periodTo         DateTime
  importedAt       DateTime             @default(now())
  importedBy       String
  status           ReconciliationStatus @default(IN_PROGRESS)
  completedAt      DateTime?
  openingBalance   Decimal              @db.Decimal(12, 2)
  closingBalance   Decimal              @db.Decimal(12, 2)
  transactionCount Int
  matchedCount     Int                  @default(0)
  unmatchedCount   Int                  @default(0)

  transactions BankTransaction[]

  @@index([periodFrom])
  @@index([deletedAt])
}

model BankTransaction {
  id                String                 @id @default(cuid())
  bankStatementId   String
  transactionDate   DateTime
  description       String
  debitAmount       Decimal?               @db.Decimal(12, 2)
  creditAmount      Decimal?               @db.Decimal(12, 2)
  balance           Decimal                @db.Decimal(12, 2)
  reference         String?
  matchStatus       TransactionMatchStatus @default(UNMATCHED)
  matchedEntityType String?
  matchedEntityId   String?
  resolvedBy        String?
  resolvedAt        DateTime?
  resolvedNote      String?

  statement BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  @@index([bankStatementId])
  @@index([matchStatus])
  @@index([transactionDate])
}

model TaxRate {
  id            String    @id @default(cuid())
  name          String
  ratePercent   Decimal   @db.Decimal(5, 2)
  country       String
  serviceType   String?
  effectiveFrom DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  invoices  Invoice[]
  retainers RetainerContract[]

  @@index([country])
  @@index([serviceType])
  @@index([isActive])
  @@index([deletedAt])
}

model TaxPayment {
  id            String    @id @default(cuid())
  authorityName String
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("RWF")
  paidAt        DateTime
  reference     String?
  periodFrom    DateTime
  periodTo      DateTime
  notes         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([paidAt])
  @@index([periodFrom])
  @@index([deletedAt])
}

enum RetainerStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model RetainerContract {
  id                String         @id @default(cuid())
  clientId          String
  ventureId         String?
  serviceName       String
  description       String?
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("USD")
  billingDayOfMonth Int
  startDate         DateTime
  endDate           DateTime?
  originalEndDate   DateTime?
  extensionCount    Int            @default(0)
  status            RetainerStatus @default(ACTIVE)
  taxRateId         String?
  nextBillingDate   DateTime
  lastBilledAt      DateTime?
  pausedAt          DateTime?
  pauseReason       String?
  endedAt           DateTime?
  endReason         String?
  notes             String?
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  taxRate         TaxRate?            @relation(fields: [taxRateId], references: [id])
  invoices        Invoice[]           @relation("RetainerInvoices")
  marketingClient MarketingClient?
  client          Client              @relation(fields: [clientId], references: [id])
  venture         Venture?            @relation(fields: [ventureId], references: [id])
  extensions      RetainerExtension[]

  @@index([status])
  @@index([nextBillingDate])
  @@index([clientId])
  @@index([ventureId])
  @@index([deletedAt])
}

model RetainerExtension {
  id                 String    @id @default(cuid())
  retainerContractId String
  previousEndDate    DateTime?
  newEndDate         DateTime?
  previousAmount     Decimal   @db.Decimal(12, 2)
  newAmount          Decimal   @db.Decimal(12, 2)
  reason             String?
  extendedBy         String
  extendedAt         DateTime  @default(now())

  retainerContract RetainerContract @relation(fields: [retainerContractId], references: [id])

  @@index([retainerContractId])
}

enum BudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectBudget {
  id                String    @id @default(cuid())
  projectId         String    @unique
  projectName       String
  clientId          String
  approvedBudget    Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD")
  alertThresholdPct Int       @default(80)
  alertSentAt       DateTime?
  isBlocked         Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  increaseRequests BudgetIncreaseRequest[]

  @@index([projectId])
  @@index([clientId])
  @@index([deletedAt])
}

model BudgetIncreaseRequest {
  id              String              @id @default(cuid())
  projectId       String
  currentBudget   Decimal             @db.Decimal(12, 2)
  requestedBudget Decimal             @db.Decimal(12, 2)
  justification   String
  requestedBy     String
  status          BudgetRequestStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  budget ProjectBudget @relation(fields: [projectId], references: [projectId])

  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  LOCKED
}

enum PayrollLineItemPaymentStatus {
  PENDING
  PAID
}

model PayrollRun {
  id              String        @id @default(cuid())
  month           String
  status          PayrollStatus @default(DRAFT)
  processedAt     DateTime?
  processedBy     String?
  lockedAt        DateTime?
  lockedBy        String?
  totalGross      Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(12, 2)
  totalNet        Decimal       @default(0) @db.Decimal(12, 2)
  currency        String        @default("USD")
  notes           String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  lineItems PayrollLineItem[]
  expenses  Expense[]

  @@index([status])
  @@index([month])
  @@index([deletedAt])
}

model PayrollLineItem {
  id               String                       @id @default(cuid())
  payrollRunId     String
  employeeId       String
  employeeName     String
  employeeEmail    String
  baseSalary       Decimal                      @db.Decimal(12, 2)
  commission       Decimal                      @default(0) @db.Decimal(12, 2)
  bonus            Decimal                      @default(0) @db.Decimal(12, 2)
  grossPay         Decimal                      @db.Decimal(12, 2)
  taxDeduction     Decimal                      @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal                      @default(0) @db.Decimal(12, 2)
  netPay           Decimal                      @db.Decimal(12, 2)
  payslipSent      Boolean                      @default(false)
  payslipUrl       String?
  notes            String?
  adjustedBy       String?
  adjustmentReason String?
  paymentStatus    PayrollLineItemPaymentStatus @default(PENDING)
  paidAt           DateTime?
  paidBy           String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   User?      @relation("EmployeePayroll", fields: [employeeId], references: [id])

  @@index([payrollRunId])
  @@index([employeeId])
}

model EmployeeSalary {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employeeName  String
  employeeEmail String
  baseSalary    Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee User @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([isActive])
}

enum BalanceSheetType {
  ASSET
  LIABILITY
}

model BalanceSheetEntry {
  id        String           @id @default(cuid())
  type      BalanceSheetType
  label     String
  amount    Decimal          @db.Decimal(12, 2)
  currency  String           @default("USD")
  asOfDate  DateTime         @default(now())
  notes     String?
  createdBy String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([asOfDate])
  @@index([deletedAt])
}

model FinanceSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model Venture {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String    @default("6366F1")
  isActive    Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  incomeEntries     VentureIncome[]
  expenseEntries    VentureExpense[]
  invoices          Invoice[]
  expenses          Expense[]
  clients           Client[]
  directIncome      DirectIncome[]
  retainerContracts RetainerContract[]
  leads             Lead[]

  @@index([isActive])
  @@index([deletedAt])
}

model VentureIncome {
  id          String    @id @default(cuid())
  ventureId   String
  description String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  category    String
  date        DateTime
  reference   String?
  notes       String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  venture Venture @relation(fields: [ventureId], references: [id])

  @@index([ventureId])
  @@index([date])
  @@index([category])
  @@index([deletedAt])
}

model VentureExpense {
  id            String          @id @default(cuid())
  ventureId     String
  description   String
  totalAmount   Decimal         @db.Decimal(12, 2)
  ventureShare  Decimal         @db.Decimal(5, 2)
  ventureAmount Decimal         @db.Decimal(12, 2)
  currency      String          @default("USD")
  category      ExpenseCategory
