  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([projectId, assigneeId, status])
  @@index([assigneeId, dueDate])
  @@index([milestoneId, status])
  @@index([deletedAt])
}

