generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(TEAM_MEMBER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  invoices Invoice[]
  payments Payment[]
  expenses Expense[]
  commissionRules CommissionRule[] @relation("AgentCommissionRules")
  commissions     CommissionRecord[] @relation("AgentCommissions")
  notifications   Notification[]
  creditNotes     CreditNote[]

  @@index([role])
}

enum Role {
  CEO
  FINANCE_MANAGER
  SALES_AGENT
  PROJECT_MANAGER
  OPERATIONS_MANAGER
  TEAM_MEMBER
  CLIENT
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  projectId     String?
  status        InvoiceStatus @default(DRAFT)
  lineItems     Json
  subtotal      Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @db.Decimal(5, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  dueDate       DateTime
  sentAt        DateTime?
  paidAt        DateTime?
  writtenOffAt     DateTime?
  writtenOffBy     String?
  writeOffReason   String?
  writeOffCategory WriteOffCategory?
  creditTermsDays      Int           @default(30)
  notes                String?
  serviceType          String        @default("general")
  taxRateId            String?
  retainerContractId   String?
  createdBy            String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  payments         Payment[]
  reminders        InvoiceReminder[]
  creditNotes      CreditNote[]
  paymentPlan      PaymentPlan?
  appliedTaxRate   TaxRate?          @relation(fields: [taxRateId], references: [id])
  retainerContract RetainerContract? @relation("RetainerInvoices", fields: [retainerContractId], references: [id])
  creator          User              @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
  @@index([clientId])
  @@index([serviceType])
  @@index([paidAt])
  @@index([taxRateId])
  @@index([retainerContractId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum WriteOffCategory {
  CLIENT_DISPUTE
  CLIENT_INSOLVENT
  AGREED_WRITE_OFF
  UNCOLLECTABLE
  OTHER
}

model InvoiceReminder {
  id             String   @id @default(cuid())
  invoiceId      String
  reminderNumber Int
  sentAt         DateTime @default(now())
  emailAddress   String

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, reminderNumber])
  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  paidAt      DateTime
  receiptSent Boolean       @default(false)
  notes       String?
  recordedBy  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  recorder User    @relation(fields: [recordedBy], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
  CARD
}

model Expense {
  id         String          @id @default(cuid())
  vendorName String
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  currency   String          @default("USD")
  date       DateTime
  projectId          String?
  internalHourlyCost Decimal?        @db.Decimal(10, 2)
  receiptUrl         String?
  uploadPath         String?
  notes              String?
  createdBy          String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  creator User @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([date])
  @@index([projectId])
}

enum ExpenseCategory {
  STAFF
  SOFTWARE
  MARKETING
  OFFICE
  TRAVEL
  SUPPLIER
  OTHER
}

model Bill {
  id            String     @id @default(cuid())
  vendorName    String
  category      String
  amount        Decimal    @db.Decimal(12, 2)
  currency      String     @default("USD")
  dueDate       DateTime
  status        BillStatus @default(UNPAID)
  paidAt        DateTime?
  attachmentUrl String?
  notes         String?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@index([status])
  @@index([dueDate])
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model CommissionRule {
  id            String    @id @default(cuid())
  agentId       String
  serviceType   String?
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent User @relation("AgentCommissionRules", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([effectiveFrom])
  @@index([agentId, serviceType])
}

model CommissionRecord {
  id               String           @id @default(cuid())
  agentId          String
  dealId           String           @unique
  dealValue        Decimal          @db.Decimal(12, 2)
  serviceType      String
  ratePercent      Decimal          @db.Decimal(5, 2)
  calculatedAmount Decimal          @db.Decimal(12, 2)
  adjustedAmount   Decimal?         @db.Decimal(12, 2)
  adjustmentReason String?
  month            String
  status           CommissionStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  agent User @relation("AgentCommissions", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([month])
  @@index([status])
  @@index([month, status])
}

enum NotificationType {
  INVOICE_OVERDUE
  INVOICE_REMINDER_SENT
  INVOICE_PAID
  BILL_DUE_SOON
  BILL_OVERDUE
  PAYMENT_RECEIVED
  COMMISSION_APPROVED
  COMMISSION_REJECTED
  REMINDER_FAILED
  BUDGET_ALERT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model FinanceAuditLog {
  id            String   @id @default(cuid())
  userId        String
  userEmail     String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model CashFlowAdjustment {
  id        String    @id @default(cuid())
  label     String
  amount    Decimal   @db.Decimal(12, 2)
  direction String
  date      DateTime
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([date])
}

enum CreditNoteReason {
  OVERCHARGE
  SERVICE_NOT_DELIVERED
  DISCOUNT_AGREED
  REFUND_APPROVED
  OTHER
}

enum CreditNoteStatus {
  ISSUED
  REFUND_PENDING
  REFUND_PAID
  VOID
}

model CreditNote {
  id               String           @id @default(cuid())
  creditNoteNumber String           @unique
  invoiceId        String
  amount           Decimal          @db.Decimal(12, 2)
  reason           CreditNoteReason
  description      String
  status           CreditNoteStatus @default(ISSUED)
  issuedAt         DateTime         @default(now())
  refundDue        Boolean          @default(false)
  refundPaidAt     DateTime?
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@index([createdAt])
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstalmentStatus {
  PENDING
  PAID
  OVERDUE
}

model PaymentPlan {
  id          String            @id @default(cuid())
  invoiceId   String            @unique
  totalAmount Decimal           @db.Decimal(12, 2)
  status      PaymentPlanStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  invoice     Invoice           @relation(fields: [invoiceId], references: [id])
  instalments PaymentPlanItem[]
}

model PaymentPlanItem {
  id               String           @id @default(cuid())
  paymentPlanId    String
  instalmentNumber Int
  amount           Decimal          @db.Decimal(12, 2)
  dueDate          DateTime
  status           InstalmentStatus @default(PENDING)
  paidAt           DateTime?
  paymentId        String?

  plan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId])
  @@index([dueDate])
  @@index([status])
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
  DISCREPANCY
}

enum TransactionMatchStatus {
  MATCHED
  UNMATCHED
  MANUALLY_RESOLVED
  IGNORED
}

model BankStatement {
  id               String               @id @default(cuid())
  periodFrom       DateTime
  periodTo         DateTime
  importedAt       DateTime             @default(now())
  importedBy       String
  status           ReconciliationStatus @default(IN_PROGRESS)
  completedAt      DateTime?
  openingBalance   Decimal              @db.Decimal(12, 2)
  closingBalance   Decimal              @db.Decimal(12, 2)
  transactionCount Int
  matchedCount     Int                  @default(0)
  unmatchedCount   Int                  @default(0)

  transactions BankTransaction[]

  @@index([periodFrom])
}

model BankTransaction {
  id                String                 @id @default(cuid())
  bankStatementId   String
  transactionDate   DateTime
  description       String
  debitAmount       Decimal?               @db.Decimal(12, 2)
  creditAmount      Decimal?               @db.Decimal(12, 2)
  balance           Decimal                @db.Decimal(12, 2)
  reference         String?
  matchStatus       TransactionMatchStatus @default(UNMATCHED)
  matchedEntityType String?
  matchedEntityId   String?
  resolvedBy        String?
  resolvedAt        DateTime?
  resolvedNote      String?

  statement BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  @@index([bankStatementId])
  @@index([matchStatus])
  @@index([transactionDate])
}

model TaxRate {
  id            String    @id @default(cuid())
  name          String
  ratePercent   Decimal   @db.Decimal(5, 2)
  country       String
  serviceType   String?
  effectiveFrom DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoices  Invoice[]
  retainers RetainerContract[]

  @@index([country])
  @@index([serviceType])
  @@index([isActive])
}

model TaxPayment {
  id            String   @id @default(cuid())
  authorityName String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("RWF")
  paidAt        DateTime
  reference     String?
  periodFrom    DateTime
  periodTo      DateTime
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([paidAt])
  @@index([periodFrom])
}

enum RetainerStatus {
  ACTIVE
  PAUSED
  ENDED
}

model RetainerContract {
  id                String         @id @default(cuid())
  clientId          String
  serviceName       String
  description       String?
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("USD")
  billingDayOfMonth Int
  startDate         DateTime
  endDate           DateTime?
  status            RetainerStatus @default(ACTIVE)
  taxRateId         String?
  nextBillingDate   DateTime
  lastBilledAt      DateTime?
  pausedAt          DateTime?
  pauseReason       String?
  endedAt           DateTime?
  endReason         String?
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  taxRate  TaxRate?  @relation(fields: [taxRateId], references: [id])
  invoices Invoice[] @relation("RetainerInvoices")

  @@index([status])
  @@index([nextBillingDate])
  @@index([clientId])
}

enum BudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectBudget {
  id                String    @id @default(cuid())
  projectId         String    @unique
  projectName       String
  clientId          String
  approvedBudget    Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD")
  alertThresholdPct Int       @default(80)
  alertSentAt       DateTime?
  isBlocked         Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  increaseRequests BudgetIncreaseRequest[]

  @@index([projectId])
  @@index([clientId])
}

model BudgetIncreaseRequest {
  id              String              @id @default(cuid())
  projectId       String
  currentBudget   Decimal             @db.Decimal(12, 2)
  requestedBudget Decimal             @db.Decimal(12, 2)
  justification   String
  requestedBy     String
  status          BudgetRequestStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  budget ProjectBudget @relation(fields: [projectId], references: [projectId])

  @@index([projectId])
  @@index([status])
}
