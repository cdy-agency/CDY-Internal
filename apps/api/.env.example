DATABASE_URL="postgresql://postgres:password@localhost:5433/cdy_system"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3251
NODE_ENV="development"
FRONTEND_URL="http://localhost:3250"
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="finance@cdy.com"
SENTRY_DSN="https://your-dsn@sentry.io/project-id"

# Initial defaults for excluding pre-migration data from the CEO dashboard and
# Finance summary totals. Only read once, to seed the FinanceSetting rows
# (exclude_old_data_enabled / exclude_old_data_cutoff) the first time the app
# boots against a given database. After that, both are edited live via the
# toggle on the CEO dashboard and these env vars are no longer consulted.
EXCLUDE_OLD_DATA_ENABLED=true
EXCLUDE_OLD_DATA_CUTOFF=2026-06-22
