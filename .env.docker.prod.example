# Production environment — copy to .env.docker on the server:
#   cp .env.docker.prod.example .env.docker
#
# Public URL: https://inhouse.cdyagency.com
# Host nginx (system) proxies :443 → 127.0.0.1:3250 (web) and :3251 (api)

# PostgreSQL (internal to Docker — do not expose 5432 on the host)
POSTGRES_USER=cdy_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cdy_system

# JWT — use unique secrets in production (32+ chars)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email
RESEND_API_KEY=re_your_production_key
RESEND_FROM_EMAIL=finance@cdy.com

# Public-facing domain (CORS, invoice links, emails)
FRONTEND_URL=https://inhouse.cdyagency.com

# Next.js server → API inside Docker network (not the public URL)
NEXT_PUBLIC_API_URL=http://api:3251/api/v1

NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET

# Sentry (optional)
SENTRY_DSN=https://150f757a953e9462db77e34903565813@o4511587426172928.ingest.us.sentry.io/4511587442032640
NEXT_PUBLIC_SENTRY_DSN=https://3a138a5407d8be94eccd6156328a618d@o4511587426172928.ingest.us.sentry.io/4511587443998720

# Seed on API container startup (after migrate deploy)
# Runs once — skipped automatically if users already exist
SEED_ON_STARTUP=true

# Set SEED_FORCE=true only to wipe and reseed (destructive — never in production unless intentional)
SEED_FORCE=false
