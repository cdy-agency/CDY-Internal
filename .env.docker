# PostgreSQL
POSTGRES_USER=cdy_user
POSTGRES_PASSWORD=cdy_secure_password_change_me
POSTGRES_DB=cdy_system
# Host access (e.g. local Prisma CLI outside Docker): localhost:5433

# JWT
JWT_SECRET=cdy-jwt-secret-minimum-32-chars-change-in-production
JWT_REFRESH_SECRET=cdy-refresh-secret-minimum-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=finance@cdy.com

# URLs (development defaults — use .env.docker.prod.example on the server)
FRONTEND_URL=http://localhost:3250
NEXT_PUBLIC_API_URL=http://localhost:3251/api/v1
NEXTAUTH_SECRET=cdy-nextauth-secret-change-in-production

# Production public URL: https://inhouse.cdyagency.com
# Production: copy .env.docker.prod.example → .env.docker on the server
